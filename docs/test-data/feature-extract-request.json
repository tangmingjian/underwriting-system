  "_features_quick_ref": {
    "EXTERNAL_API (ORDER聚合)": {
      "ins.creditScore": { "agg": "ORDER", "storage": "INSURED", "ttl": 300 },
      "ord.fraudRiskScore": { "agg": "ORDER", "storage": "ORDER", "ttl": 600 },
      "BASE_RISK": { "agg": "ORDER", "storage": "INSURED", "ttl": 300, "note": "批量查询，RISK_SCORE/FRAUD_CHECK 的上游依赖" }
    },
    "EXTERNAL_API (POLICY聚合)": {
      "ins.occupationRisk": { "agg": "POLICY", "storage": "INSURED", "ttl": 1800 },
      "app.incomeVerified": { "agg": "POLICY", "storage": "APPLICANT", "ttl": 600 },
      "pol.maxSumAssured": { "agg": "POLICY", "storage": "POLICY", "ttl": 3600 }
    },
    "PARAM_MAPPING (ORDER聚合)": {
      "pol.appliedAmount": { "agg": "ORDER", "storage": "POLICY", "ttl": -1 },
      "ord.channel": { "agg": "ORDER", "storage": "ORDER", "ttl": -1 },
      "ord.applicantRiskLevel": { "agg": "ORDER", "storage": "APPLICANT", "ttl": -1 },
      "RISK_SCORE": { "agg": "ORDER", "storage": "INSURED", "ttl": -1, "dependsOn": "BASE_RISK" },
