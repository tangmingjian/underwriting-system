                "id": "APP_001", "idNo": "110101199003151234", "name": "张建国",
                "age": 36, "gender": "M",
                "customerNos": ["CUST_A_001", "CUST_A_002"]
              },
              "insureds": [
                {
                  "id": "INS_001", "idNo": "110101199003151234", "name": "张建国",
                  "age": 36, "gender": "M", "occupation": "软件工程师",
                  "customerNos": ["CUST_A_001", "CUST_A_002"]
                },
                {
                  "id": "INS_002", "idNo": "110101199506152345", "name": "李美玲",
                  "age": 31, "gender": "F", "occupation": "医生",
                  "customerNos": ["CUST_B_001"]
                }
              ],
              "declaredIncome": 300000,
              "appliedAmount": 1000000
            }
          ]
        },
        "policyInsuredFeatureMap": {
          "POL_001": {
            "INS_001": ["RISK_SCORE", "FRAUD_CHECK"],
            "INS_002": ["RISK_SCORE", "FRAUD_CHECK"]
          }
        },
        "policyApplicantFeatureMap": {}
      }
    },

