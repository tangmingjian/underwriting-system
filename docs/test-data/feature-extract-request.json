        "order": {
          "id": "ORD_20260604_004",
          "channel": "ONLINE",
          "orderTime": "2026-06-04T11:00:00",
          "policies": [
            {
              "id": "POL_001",
              "product": { "productCode": "HEALTH_A_001", "productName": "健康险A款" },
