            },
            {
              "id": "POL_002",
              "product": { "productCode": "ACCIDENT_B_002", "productName": "意外险B款" },
              "applicant": {
                "id": "APP_002", "idNo": "110101198812016789", "name": "王大明",
                "age": 38, "gender": "M",
                "customerNos": ["CUST_C_001"]
              },
              "insureds": [
                {
                  "id": "INS_003", "idNo": "110101198812016789", "name": "王大明",
