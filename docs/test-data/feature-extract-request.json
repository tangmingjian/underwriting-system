{
  "_description": "api/feature/extract 接口多场景入参报文。支持 9 种 Aggregation×Storage 组合 + 依赖链 + 批处理 + 部分映射",
  "_note": "FeatureExtractionRequest 只有 4 个字段: order, policyInsuredFeatureMap, policyApplicantFeatureMap, customerNos。featureCodes 由 getFeatureCodes() 从两个 map 自动推导。",

  "scenarios": {

    "scenario-1-simple-order": {
      "description": "单保单简单订单，覆盖 PARAM_MAPPING 特征：ins.age, ins.gender, ins.occupation, ord.channel, pol.appliedAmount",
      "request": {
        "order": {
          "id": "ORD_20260601_001",
          "channel": "ONLINE",
          "orderTime": "2026-06-01T10:30:00",
          "policies": [
            {
              "id": "POL_001",
              "product": { "productCode": "HEALTH_A_001", "productName": "健康险A款" },
              "applicant": {
                "id": "APP_001", "idNo": "110101199003151234", "name": "张建国",
                "age": 36, "gender": "M",
                "customerNos": ["CUST_A_001", "CUST_A_002"]
              },
              "insureds": [
                {
                  "id": "INS_001", "idNo": "110101199003151234", "name": "张建国",
                  "age": 36, "gender": "M", "occupation": "软件工程师", "phone": "13800001111",
                  "customerNos": ["CUST_A_001", "CUST_A_002"]
                }
              ],
              "declaredIncome": 300000,
              "appliedAmount": 1000000
            }
          ]
        },
        "policyInsuredFeatureMap": {
          "POL_001": {
            "INS_001": ["ins.age", "ins.gender", "ins.occupation"]
          }
        },
        "policyApplicantFeatureMap": {
          "POL_001": {
            "APP_001": ["ord.channel", "pol.appliedAmount"]
          }
        }
      }
    },

    "scenario-2-multi-policy-cross-person": {
      "description": "多保单同人跨保单：INS_001(张建国) 同时出现在 POL_001(健康险) 和 POL_002(意外险)，各自需要不同特征。覆盖 ORDER→INSURED / POLICY→INSURED 路由",
      "request": {
        "order": {
          "id": "ORD_20260602_002",
          "channel": "ONLINE",
          "orderTime": "2026-06-02T14:00:00",
          "policies": [
            {
              "id": "POL_001",
              "product": { "productCode": "HEALTH_A_001", "productName": "健康险A款" },
              "applicant": {
                "id": "APP_001", "idNo": "110101199003151234", "name": "张建国",
                "age": 36, "gender": "M",
                "customerNos": ["CUST_A_001", "CUST_A_002", "CUST_A_003"]
              },
              "insureds": [
                {
                  "id": "INS_001", "idNo": "110101199003151234", "name": "张建国",
                  "age": 36, "gender": "M", "occupation": "软件工程师",
                  "customerNos": ["CUST_A_001", "CUST_A_002", "CUST_A_003"]
                },
                {
                  "id": "INS_002", "idNo": "110101199506152345", "name": "李美玲",
                  "age": 31, "gender": "F", "occupation": "医生",
                  "customerNos": ["CUST_B_001", "CUST_B_002"]
                }
              ],
              "declaredIncome": 300000,
              "appliedAmount": 1000000
            },
            {
              "id": "POL_002",
              "product": { "productCode": "ACCIDENT_B_002", "productName": "意外险B款" },
              "applicant": {
                "id": "APP_002", "idNo": "110101198812016789", "name": "王大明",
                "age": 38, "gender": "M",
                "customerNos": ["CUST_C_001"]
              },
              "insureds": [
                {
                  "id": "INS_001", "idNo": "110101199003151234", "name": "张建国",
                  "age": 36, "gender": "M", "occupation": "软件工程师",
                  "customerNos": ["CUST_A_001", "CUST_A_002", "CUST_A_003"]
                },
                {
                  "id": "INS_003", "idNo": "110101199210019876", "name": "赵小红",
                  "age": 34, "gender": "F", "occupation": "会计",
                  "customerNos": ["CUST_D_001", "CUST_D_002"]
                }
              ],
              "declaredIncome": 150000,
              "appliedAmount": 200000
            }
          ]
        },
        "policyInsuredFeatureMap": {
          "POL_001": {
            "INS_001": ["ins.age", "ins.gender", "ins.creditScore"],
            "INS_002": ["ins.age", "ins.creditScore"]
          },
          "POL_002": {
            "INS_001": ["ins.occupationRisk", "ins.occupation"],
            "INS_003": ["ins.occupationRisk", "ins.gender"]
          }
        },
        "policyApplicantFeatureMap": {
          "POL_001": {
            "APP_001": ["app.incomeVerified"]
          },
          "POL_002": {
            "APP_002": ["app.incomeVerified"]
          }
        }
      }
    },

    "scenario-3-all-9-combos": {
      "description": "覆盖全部 9 种 Aggregation×Storage 有效组合：ORDER→ORDER/POLICY/APPLICANT/INSURED, POLICY→POLICY/APPLICANT/INSURED, APPLICANT→APPLICANT, INSURED→INSURED",
      "request": {
        "order": {
          "id": "ORD_20260603_003",
          "channel": "AGENT",
          "orderTime": "2026-06-03T09:00:00",
          "policies": [
            {
              "id": "POL_001",
              "product": { "productCode": "HEALTH_A_001", "productName": "健康险A款" },
              "applicant": {
                "id": "APP_001", "idNo": "110101199003151234", "name": "张建国",
                "age": 36, "gender": "M",
                "customerNos": ["CUST_A_001"]
              },
              "insureds": [
                {
                  "id": "INS_001", "idNo": "110101199003151234", "name": "张建国",
                  "age": 36, "gender": "M", "occupation": "软件工程师",
                  "customerNos": ["CUST_A_001"]
                },
                {
                  "id": "INS_002", "idNo": "110101199506152345", "name": "李美玲",
                  "age": 31, "gender": "F", "occupation": "医生",
                  "customerNos": ["CUST_B_001"]
                }
              ],
              "declaredIncome": 300000,
              "appliedAmount": 1000000
            }
          ]
        },
        "policyInsuredFeatureMap": {
          "POL_001": {
            "INS_001": [
              "ins.creditScore", "ins.occupationRisk", "ins.personalRisk",
              "ins.age", "ins.gender", "ins.occupation",
              "BASE_RISK", "RISK_SCORE", "FRAUD_CHECK"
            ],
            "INS_002": [
              "ins.creditScore", "ins.occupationRisk", "ins.personalRisk",
              "ins.age", "ins.gender",
              "BASE_RISK", "RISK_SCORE", "FRAUD_CHECK"
            ]
          }
        },
        "policyApplicantFeatureMap": {
          "POL_001": {
            "APP_001": [
              "ord.fraudRiskScore", "ord.applicantRiskLevel",
              "app.incomeVerified", "app.creditRating",
              "pol.maxSumAssured", "pol.appliedAmount",
              "ord.channel"
            ]
          }
        }
      }
    },

    "scenario-4-dependency-chain": {
      "description": "依赖链执行：BASE_RISK(EXTERNAL_API,无依赖) → RISK_SCORE(dependsOn=BASE_RISK) → FRAUD_CHECK(dependsOn=BASE_RISK)。拓扑排序 2 层",
